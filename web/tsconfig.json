{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    /* Bundler mode */
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Shared contracts live in packages/craftlife-core (UPDATE_RULES P2).
       Mapped to the package SOURCE so `tsc` and `vite build` never depend on
       dist/ having been built first — the §7 gate command stays standalone. */
    "baseUrl": ".",
    "paths": {
      "@craftlife/core": ["../packages/craftlife-core/src/index.ts"]
    }
  },
  "include": ["src"]
}
